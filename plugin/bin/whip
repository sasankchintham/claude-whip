#!/usr/bin/env bash
# Crack the whip once by asking the Whip GNOME Shell extension to draw it at the mouse.
# Does nothing (silently) if the extension isn't installed.
exec gdbus call --session --dest org.gnome.Shell \
  --object-path /org/gnome/Shell/Extensions/WhipGroomer \
  --method org.gnome.Shell.Extensions.WhipGroomer.Crack >/dev/null 2>&1

#!/usr/bin/env bash
# Claude Code hook: `slow-whip start` when a prompt is submitted, `slow-whip stop` when Claude
# finishes. If Claude is still working after CLAUDE_WHIP_DELAY seconds (default 10), the whip
# cracks, then every CLAUDE_WHIP_INTERVAL seconds (default 3), at most MAX_CRACKS times per task.
# The cap also covers the cases where no stop hook fires, such as pressing Esc.
# It prints nothing, so Claude never sees it.
set -u
dir="$(cd "$(dirname "$0")" && pwd)"
MAX_CRACKS=5

session="$(sed -n 's/.*"session_id" *: *"\([^"]*\)".*/\1/p' | head -n 1 | tr -cd 'A-Za-z0-9-' | cut -c1-64)"
# XDG_RUNTIME_DIR is private to this user; never fall back to world-writable /tmp.
state="${XDG_RUNTIME_DIR:-$HOME/.cache}/claude-whip"
mkdir -p -m 700 "$state"
pidfile="$state/${session:-default}.pid"

if [ -f "$pidfile" ] && [ ! -L "$pidfile" ]; then
  pid="$(tr -cd '0-9' < "$pidfile")"
  # only kill it if it is still our own timer loop, not some unrelated reused PID
  # (ps works on both Linux and macOS, unlike /proc)
  if [ -n "$pid" ] && ps -p "$pid" -o command= 2>/dev/null | grep -q 'claude-whip-timer'; then
    kill "$pid" 2>/dev/null
  fi
  rm -f "$pidfile"
fi

[ "${1:-}" = start ] || exit 0

number_or() { case "$1" in ''|*[!0-9]*) echo "$2" ;; *) echo "$1" ;; esac; }
delay="$(number_or "${CLAUDE_WHIP_DELAY:-}" 10)"
interval="$(number_or "${CLAUDE_WHIP_INTERVAL:-}" 3)"
[ "$interval" -ge 1 ] || interval=1

# arguments are passed positionally, never spliced into the script text
nohup bash -c 'sleep "$2"; i=0; while [ "$i" -lt "$4" ]; do "$1/whip"; i=$((i + 1)); sleep "$3"; done; rm -f "$5"' \
  claude-whip-timer "$dir" "$delay" "$interval" "$MAX_CRACKS" "$pidfile" </dev/null >/dev/null 2>&1 &
echo $! > "$pidfile"
